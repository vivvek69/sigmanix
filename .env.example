# Groq API Key - Get from: https://console.groq.com
GROQ_API_KEY=your_api_key_here

# Flask Configuration
FLASK_ENV=production
# Generate a strong SECRET_KEY: python generate_secret.py
SECRET_KEY=your-secret-key-here-generate-random-string

# CORS Configuration - Comma-separated domains (no spaces between values)
# Include your frontend dev server and deployed backend origin(s)
# Example: http://localhost:5173,https://your-deploy.replit.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdeploy.replit.app

# Session cookie security (for production/deployed servers)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Database
DATABASE_PATH=chatbot_database.db

# Port (Render sets this automatically, default 5000 for local)
PORT=5000

# Notes:
# - DO NOT commit real secrets to git; use .env.example as template only
# - On Render: set all variables in Environment section
# - On Replit: set all variables in Secrets panel
# - After changing env vars, restart the server
